# Prevent directory browsing
Options -Indexes

# Protect hidden files (like .env, .git, .htaccess itself)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Only allow execution of .php and .status files
<FilesMatch "\.(status|php)$">
    Order allow,deny
    Allow from all
</FilesMatch>

# Custom Error Pages
ErrorDocument 404 /404.php
ErrorDocument 403 /403.php
ErrorDocument 500 /500.php

# Enable Rewrite Engine (Useful for clean URLs later)
RewriteEngine On