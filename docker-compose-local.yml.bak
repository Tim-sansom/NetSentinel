services:
  dashboard:
    build: .
    platform: linux/amd64
    container_name: netsentinel-dashboard
    ports:
     - "8088:80"
     - "8443:443"  # HTTPS for external agents
    volumes:
      - ./public:/var/www/html:delegated
      - ./scripts:/var/www/scripts:ro  # Scripts
      - ./cronjobs:/var/www/cronjobs   # Cron jobs
      - ./certs:/etc/apache2/certs:ro  # SSL certificates
      - ./apache-config/netsentinel-ssl.conf:/etc/apache2/sites-enabled/netsentinel-ssl.conf:ro # SSL vhost config
    environment:
      NETSENTINEL_ENV: development
      DB_HOST: mysql
      DB_NAME: netsentinel
      DB_USER: netsentinel_user
      DB_PASS: ${MYSQL_PASSWORD}
    depends_on:
      - mysql
    restart: unless-stopped
    networks:
      - netsentinel-network

  collector:
    image: python:3.10-slim
    platform: linux/amd64
    container_name: netsentinel-collector
    working_dir: /app
    volumes:
      - ./collector:/app
    command: >
      sh -c "pip install --no-cache-dir -r requirements.txt && python collector.py"
    environment:
      PYTHONUNBUFFERED: "1"
      NETSENTINEL_ENV: development
      API_URL: http://dashboard:80/api/submit.php  # Keep HTTP for internal Docker network
      DEVICE_ID: agent-001
      DB_HOST: mysql
      DB_NAME: netsentinel
      DB_USER: netsentinel_user
      DB_PASS: ${MYSQL_PASSWORD}
    depends_on:
      - mysql
    restart: unless-stopped
    networks:
      - netsentinel-network

  mysql:
    image: mysql:8.0
    platform: linux/amd64
    container_name: netsentinel-mysql
    ports:
      - "3306:3306"
    environment:
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD}
      MYSQL_DATABASE: netsentinel
      MYSQL_USER: netsentinel_user
      MYSQL_PASSWORD: ${MYSQL_PASSWORD}
    volumes:
      - mysql_data:/var/lib/mysql
      - ./db-init:/docker-entrypoint-initdb.d
    restart: unless-stopped
    networks:
      - netsentinel-network

  phpmyadmin:
    image: phpmyadmin/phpmyadmin
    platform: linux/amd64
    container_name: netsentinel-phpmyadmin
    ports:
      - "8082:80"
    environment:
      PMA_HOST: mysql
      PMA_USER: root
      PMA_PASSWORD: ${MYSQL_ROOT_PASSWORD}
    depends_on:
      - mysql
    restart: unless-stopped
    networks:
      - netsentinel-network

networks:
  netsentinel-network:
    driver: bridge

volumes:
  mysql_data: