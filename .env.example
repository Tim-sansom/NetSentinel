# ============================================
# ENVIRONMENT MODE
# ============================================
NETSENTINEL_ENV=production

# ============================================
# DATABASE CONFIGURATION
# ============================================
# These are the credentials the Docker container will use.
# Change them to strong, unique values for your local setup.
DB_HOST=db
DB_NAME=netsentinel
DB_USER=netsentinel_user
DB_PASS=ChangeMe_To_A_Strong_Password_123!
DB_ROOT_PASSWORD=ChangeMe_To_A_Strong_Root_Password_456!

# ============================================
# AGENT CONFIGURATION (For Python Endpoint)
# ============================================
# The public URL where agents will send telemetry.
# Update this to your actual domain or local IP when deploying.
NETSENTINEL_API_URL=https://netsentinel.timsansom.co.uk/api/submit.php
NETSENTINEL_API_TOKEN=ChangeMe_To_A_Secure_Token_789!